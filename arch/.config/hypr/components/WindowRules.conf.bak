# Ignore maximize requests from apps. You'll probably like this.
windowrule {
  name = windowrule-1
  suppress_event = maximize
  opacity = 0.97 override 0.9 override
  match:class = .*
}



# Fix some dragging issues with XWayland
windowrule {
  name = windowrule-2
  no_focus = on
  match:class = ^$
  match:title = ^$
  match:xwayland = 1
  match:float = 1
  match:fullscreen = 0
  match:pin = 0
}


windowrule {
  name = windowrule-3
  float = on
  center = on
  match:class = ^(org.pulseaudio.pavucontrol|blueman-manager|Impala|org.gnome.NautilusPreviewer|Omarchy)$
}

windowrule {
  name = windowrule-4
  size = 800 600
  match:class = ^(org.pulseaudio.pavucontrol|blueman-manager|Impala|org.gnome.NautilusPreviewer)$
}

windowrule {
  name = windowrule-5
  float = on
  center = on
  match:class = xdg-desktop-portal-gtk
  match:title = ^(Open.*Files?|Save.*Files?|All Files|Save)
}


# Paradox Launcher
windowrule {
  name = windowrule-paradox-launcher
  float = on
  center = on
  match:class = Paradox Launcher
}


# HOI4
windowrule {
  name = windowrule-hoi4
  fullscreen = on
  opacity = 1 1
  match:class = hoi4
}


# Float Steam, fullscreen RetroArch
windowrule {
  name = windowrule-6
  float = on
  opacity = 1 1
  match:class = steam
}

windowrule {
  name = windowrule-7
  center = on
  match:class = steam
  match:title = Steam
}

windowrule {
  name = windowrule-8
  fullscreen = on
  opacity = 1 1
  match:class = steam_app_0
}

windowrule {
  name = windowrule-9
  fullscreen = on
  opacity = 1 1
  match:class = com.libretro.RetroArch
}



# Just dash of opacity
windowrule {
  name = windowrule-10
  opacity = 1 override 0.97 override
  match:class = ^(Chromium|chromium|google-chrome|google-chrome-unstable|zen|firefox)$
}

windowrule {
  name = windowrule-11
  opacity = 1 override 1 override
  match:initial_title = ^(youtube.com_/)$ # Youtube
}

windowrule {
  name = windowrule-12
  opacity = 1 override 1 override
  match:class = ^(zoom|vlc|mpv|org.kde.kdenlive|com.obsproject.Studio|com.github.PintaProject.Pinta|imv|org.gnome.NautilusPreviewer)$
}

windowrule {
  name = windowrule-13
  opacity = 1 override 1 override
  match:class = ^(com.libretro.RetroArch|steam)$
}



# Picture-in-picture overlays
# windowrule = tag +pip, title:(Picture.{0,1}in.{0,1}[Pp]icture)
windowrule {
  name = windowrule-14
  float = on
  pin = on
  size = 600 338
  keep_aspect_ratio = on
  border_size = 0
  opacity = 1 1
  move = ((monitor_w*1)-window_w-40) ((monitor_h*0.04))
  match:tag = pip
}


# Float and center file pickers
windowrule {
  name = windowrule-15
  center = on
  match:class = org.kde.*
  match:title = ^(Open.*Files?|Save.*Files?|All Files|Save|Open.*Ark?|Extract.*Ark?)
}



# Random rules
windowrule {
  name = windowrule-16
  opacity = 1 override 1 override
  match:initial_class = ^(sykes.gtk.example)$
}

windowrule {
  name = windowrule-17
  opacity = 1 override 1 override
  match:initial_class = ^(Microsoft.*)$
}


# GHidra
windowrule {
  name = windowrule-18
  tile = on
  opacity = 1 override 1 override
  match:class = ghidra-Ghidra
}

windowrule {
  name = windowrule-19
  float = on
  center = on
  match:title = (Tip of the Day)
}


# Jetbrains
windowrule {
  name = windowrule-20
  tag = +jb
  center = off
  match:class = ^jetbrains-.+$
}

windowrule {
  name = windowrule-21
  float = on
  no_initial_focus = on
  stay_focused = off
  opacity = override 1 override 0.85
  match:tag = jb
}

windowrule {
  name = windowrule-23
  no_focus = on
  match:class = ^jetbrains-.*$
  match:title = .*(Tooltip).*$
}

windowrule {
  name = windowrule-24
  float = on
  match:class = ^jetbrains-.*$
  match:title = .*(Dialog|Tooltip|Popup|Menu).*$
}

windowrule {
  name = windowrule-25
  float = on
  no_initial_focus = off
  center = on
  match:class = ^jetbrains-.*$
  match:title = .*(Settings|Preferences|Project Structure).*$
}

windowrule {
  name = windowrule-26
  float = on
  no_initial_focus = off
  match:class = ^jetbrains-.*$
  match:title = ^win.*$
}

