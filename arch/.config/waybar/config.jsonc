// -*- mode: jsonc -*-
{
    // Credit to d00m1k for the basis of this config
    "layer": "top", // Waybar at top layer
    "position": "top", // Waybar position (top|bottom|left|right)
    // "height": 30, // Waybar height (to be removed for auto height)
    // "width": 1280, // Waybar width
    "spacing": 0, // Gaps between modules (0px)
    // Choose the order of the modules
    "modules-left": [
        "custom/arch",
        "hyprland/workspaces"
    ],
    "modules-center": [
        "hyprland/window"
    ],
    "modules-right": [
        "idle_inhibitor",
        "pulseaudio",
        "network",
        "bluetooth",
        "cpu",
        // "memory",
        "backlight",
        // "temperature",
        // "hyprland/language",
        "battery",
        "battery#bat2",
        // "power-profiles-daemon",
        "custom/notification",
        "group/tray-expander",
        //"tray",
        "clock"
    ],
    //Modules configuration
    "include": [
        "~/.config/waybar/modules.json"
    ]
}
