# ===========================
#  i3 CONFIG — Hyprland-ish
#  ~/.config/i3/config
#  Target: Ubuntu 25.04 + xrdp
# ===========================

# --- Mod key (Hyprland uses SUPER) ---
set $mod Mod4

# --- Common apps / commands ---
set $term        alacritty
set $launcher    rofi -show drun -modi drun,window -show-icons
set $fileman     dolphin
set $browser     firefox
set $locker      i3lock -c 000000
set $screenshot  flameshot gui
set $wallpaper   feh --bg-fill "$HOME/Pictures/wallpaper.jpg"

# --- Appearance (approx Hyprland vibe) ---
# NOTE: i3 (vanilla) has no animations/rounding; picom handles transparency/blur.
font pango:JetBrainsMono NF 11
focus_follows_mouse yes
mouse_warping none
workspace_auto_back_and_forth yes

# Borders + titlebars
default_border pixel 2
default_floating_border pixel 2
hide_edge_borders smart
# Colors (Catppuccin-ish)
client.focused          #a6e3a1 #a6e3a1 #1e1e2e #1e1e2e #1e1e2e
client.unfocused        #6c7086 #6c7086 #181825 #181825 #181825
client.focused_inactive #6c7086 #6c7086 #1e1e2e #1e1e2e #1e1e2e
client.urgent           #f38ba8 #f38ba8 #1e1e2e #1e1e2e #1e1e2e

# Gaps (effective only if using i3-gaps; safe to keep here)
gaps inner 8
gaps outer 6
smart_gaps on
smart_borders on

# --- Autostart (Hyprland's exec-once equivalents) ---
# Compositor for blur/transparency (configure in ~/.config/picom/picom.conf)
exec --no-startup-id picom --experimental-backends
# Notifications
exec --no-startup-id dunst
# Wallpaper
exec_always --no-startup-id $wallpaper
# Network + Bluetooth tray (optional)
exec --no-startup-id nm-applet
exec --no-startup-id blueman-applet
# Volume tray (optional)
exec --no-startup-id volumeicon
# PolicyKit agent (optional; uncomment the one you have installed)
# exec --no-startup-id /usr/lib/polkit-kde-authentication-agent-1
# exec --no-startup-id /usr/lib/policykit-1-gnome/polkit-gnome-authentication-agent-1
# Polybar (expects ~/.config/polybar/launch.sh or a 'main' bar in config)
exec_always --no-startup-id bash -lc "~/.config/polybar/launch.sh || (pkill polybar; polybar -r main)"
# X cursor fix (RDP/clean X sessions)
exec --no-startup-id xsetroot -cursor_name left_ptr

# --- Keybinds (matching Hyprland feels) ---
# Launcher / terminal / file manager / browser
bindsym $mod+Return exec $term
bindsym $mod+d      exec $launcher
bindsym $mod+e      exec $fileman
bindsym $mod+w      exec $browser

# Session
bindsym $mod+Shift+q exec i3-msg exit
bindsym $mod+Shift+r reload
bindsym $mod+Shift+c restart
bindsym $mod+l       exec $locker

# Window basics
bindsym $mod+q kill
bindsym $mod+f fullscreen toggle
bindsym $mod+Shift+space floating toggle
bindsym $mod+space focus mode_toggle  # toggle tiling/floating focus context
floating_modifier $mod

# Focus (arrows + vim-style like many Hypr setups)
bindsym $mod+Left  focus left
bindsym $mod+Down  focus down
bindsym $mod+Up    focus up
bindsym $mod+Right focus right
bindsym $mod+h     focus left
bindsym $mod+j     focus down
bindsym $mod+k     focus up
bindsym $mod+l     focus right

# Move containers
bindsym $mod+Shift+Left  move left
bindsym $mod+Shift+Down  move down
bindsym $mod+Shift+Up    move up
bindsym $mod+Shift+Right move right
bindsym $mod+Shift+h     move left
bindsym $mod+Shift+j     move down
bindsym $mod+Shift+k     move up
bindsym $mod+Shift+l     move right

# Splits & layout
bindsym $mod+v split v
bindsym $mod+b split h
bindsym $mod+s layout stacking
bindsym $mod+t layout tabbed
bindsym $mod+e layout toggle split

# Workspaces (1–10 like Hypr)
set $ws1  "1"
set $ws2  "2"
set $ws3  "3"
set $ws4  "4"
set $ws5  "5"
set $ws6  "6"
set $ws7  "7"
set $ws8  "8"
set $ws9  "9"
set $ws10 "10"

bindsym $mod+1  workspace $ws1
bindsym $mod+2  workspace $ws2
bindsym $mod+3  workspace $ws3
bindsym $mod+4  workspace $ws4
bindsym $mod+5  workspace $ws5
bindsym $mod+6  workspace $ws6
bindsym $mod+7  workspace $ws7
bindsym $mod+8  workspace $ws8
bindsym $mod+9  workspace $ws9
bindsym $mod+0  workspace $ws10

bindsym $mod+Shift+1  move container to workspace $ws1; workspace $ws1
bindsym $mod+Shift+2  move container to workspace $ws2; workspace $ws2
bindsym $mod+Shift+3  move container to workspace $ws3; workspace $ws3
bindsym $mod+Shift+4  move container to workspace $ws4; workspace $ws4
bindsym $mod+Shift+5  move container to workspace $ws5; workspace $ws5
bindsym $mod+Shift+6  move container to workspace $ws6; workspace $ws6
bindsym $mod+Shift+7  move container to workspace $ws7; workspace $ws7
bindsym $mod+Shift+8  move container to workspace $ws8; workspace $ws8
bindsym $mod+Shift+9  move container to workspace $ws9; workspace $ws9
bindsym $mod+Shift+0  move container to workspace $ws10; workspace $ws10

# Scratchpad (handy for quick terminals)
bindsym $mod+minus move scratchpad
bindsym $mod+Shift+minus scratchpad show

# Screenshots / screen record (X11-friendly)
bindsym Print          exec flameshot full -c -p "$HOME/Pictures/Screenshots"
bindsym $mod+Print     exec $screenshot
# (optional) region shot: bindsym Shift+Print exec "flameshot gui -r | xclip -selection clipboard -t image/png"

# Audio controls (pactl)
bindsym XF86AudioRaiseVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ +5%
bindsym XF86AudioLowerVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ -5%
bindsym XF86AudioMute        exec --no-startup-id pactl set-sink-mute   @DEFAULT_SINK@ toggle
bindsym XF86AudioMicMute     exec --no-startup-id pactl set-source-mute @DEFAULT_SOURCE@ toggle
bindsym XF86AudioPlay        exec --no-startup-id playerctl play-pause
bindsym XF86AudioNext        exec --no-startup-id playerctl next
bindsym XF86AudioPrev        exec --no-startup-id playerctl previous
bindsym XF86AudioStop        exec --no-startup-id playerctl stop

# Brightness (brightnessctl)
bindsym XF86MonBrightnessUp   exec --no-startup-id brightnessctl set +5%
bindsym XF86MonBrightnessDown exec --no-startup-id brightnessctl set 5%-

# Resize mode (like Hyprland’s resize submap idea)
bindsym $mod+r mode "resize"
mode "resize" {
    bindsym h resize shrink width 10 px or 10 ppt
    bindsym j resize grow   height 10 px or 10 ppt
    bindsym k resize shrink height 10 px or 10 ppt
    bindsym l resize grow   width 10 px or 10 ppt
    bindsym Left  resize shrink width 10 px or 10 ppt
    bindsym Down  resize grow   height 10 px or 10 ppt
    bindsym Up    resize shrink height 10 px or 10 ppt
    bindsym Right resize grow   width 10 px or 10 ppt
    bindsym Return mode "default"
    bindsym Escape mode "default"
}

# Move container to next/prev output (multi-monitor helpers)
bindsym $mod+Ctrl+Left  move workspace to output left
bindsym $mod+Ctrl+Right move workspace to output right

# For floating windows like dialogs
for_window [window_role="pop-up"] floating enable
for_window [window_type="dialog"] floating enable
for_window [class="Pavucontrol"] floating enable
for_window [class="Blueman-manager"] floating enable

# Disable i3bar (we're using Polybar). If you want i3bar, uncomment this block.
# bar {
#   status_command i3status
# }

# --- RDP friendliness ---
# xrdp uses ~/.xsession to start i3. No special config needed here, but tray apps help.

# --- Optional: pywal autoload (if you theme via pywal) ---
# exec_always --no-startup-id bash -lc 'wal -R'

# --- Theming helpers for GTK/Qt (optional; tweak to preference) ---
# exec --no-startup-id lxappearance
# exec --no-startup-id qt5ct

