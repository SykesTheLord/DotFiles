#!/bin/bash
# Parses ~/.config/omarchy/current/theme/colors.toml and writes
# ~/.config/omarchy/current/zsh-theme-colors.zsh with 24-bit ANSI color variables
# for the sykes_omarchy zsh theme. Called automatically on omarchy theme changes.

set -euo pipefail

COLORS_TOML="$HOME/.config/omarchy/current/theme/colors.toml"
OUTPUT="$HOME/.config/omarchy/current/zsh-theme-colors.zsh"

# Read a hex color value from colors.toml (e.g. accent = "#7c3aed" → "7c3aed")
parse_hex() {
    local key="$1"
    grep -E "^${key}\s*=" "$COLORS_TOML" 2>/dev/null \
        | sed 's/.*"#\([0-9a-fA-F]\{6\}\)".*/\1/' \
        | head -1
}

# Convert 6-char hex to decimal R;G;B string suitable for ANSI SGR
hex_to_rgb() {
    local h="$1"
    printf "%d;%d;%d" "0x${h:0:2}" "0x${h:2:2}" "0x${h:4:2}"
}

if [[ ! -f "$COLORS_TOML" ]]; then
    echo "omarchy-zsh-colors-set: colors.toml not found at $COLORS_TOML" >&2
    exit 1
fi

# Mappings: bracket/accent → accent color, path/time → bright cyan (color14),
# git branch → bright green (color10), ruby → bright yellow (color11)
ACCENT_HEX=$(parse_hex "accent")
CYAN_HEX=$(parse_hex "color14")
[[ -z "$CYAN_HEX" ]] && CYAN_HEX=$(parse_hex "color6")
GREEN_HEX=$(parse_hex "color10")
[[ -z "$GREEN_HEX" ]] && GREEN_HEX=$(parse_hex "color2")
YELLOW_HEX=$(parse_hex "color11")
[[ -z "$YELLOW_HEX" ]] && YELLOW_HEX=$(parse_hex "color3")

# Require at least the accent color
if [[ -z "$ACCENT_HEX" ]]; then
    echo "omarchy-zsh-colors-set: could not parse accent from $COLORS_TOML" >&2
    exit 1
fi

ACCENT_RGB=$(hex_to_rgb "$ACCENT_HEX")
CYAN_RGB=$(hex_to_rgb "${CYAN_HEX:-8be9fd}")
GREEN_RGB=$(hex_to_rgb "${GREEN_HEX:-50fa7b}")
YELLOW_RGB=$(hex_to_rgb "${YELLOW_HEX:-f1fa8c}")

# ESC must be a real byte in the file — \e in a bash heredoc stays as two
# characters and zsh doesn't interpret it in plain double-quoted assignments.
ESC=$'\033'
THEME_NAME=$(cat "$HOME/.config/omarchy/current/theme.name" 2>/dev/null || echo unknown)

mkdir -p "$(dirname "$OUTPUT")"
cat > "$OUTPUT" << EOF
# Generated by omarchy-zsh-colors-set — do not edit manually
# Theme: ${THEME_NAME}
_BRACKET="%{${ESC}[1;38;2;${ACCENT_RGB}m%}"
_ACCENT="%{${ESC}[38;2;${CYAN_RGB}m%}"
_GIT="%{${ESC}[1;38;2;${GREEN_RGB}m%}"
_RUBY="%{${ESC}[38;2;${YELLOW_RGB}m%}"
_RESET="%{${ESC}[0m%}"
EOF
